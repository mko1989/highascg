From 5f99d1fcbdfa509b741a995ab286e1a29b6d4299 Mon Sep 17 00:00:00 2001
From: C-alcaide <calcaide@tres60.tv>
Date: Tue, 4 Aug 2026 03:45:02 +0200
Subject: [PATCH 1/2] fix(mixer): film grain response was driven by a luma with
 R and B exchanged

This backend carries the pixel through the chain in the mixer native BGR channel
order, so c.r holds blue. ContrastSaturationBrightness in this same file already
accounts for it by taking luma_coeff.bgr; apply_film_grain did not, so its
photographic response curve -- the smoothstep pair that suppresses grain in deep
shadow and clipped highlight -- was keyed on a luminance with red Rec.709 coefficient
applied to blue and blue to red.

The effect is that grain lands in the wrong tonal range on saturated colour: a
saturated blue reads as brighter than it is and a saturated red as darker, so the
response is misplaced in both directions. Greys are unaffected, R=G=B making the
exchange a no-op, which is why a grey-ramp check would not show it.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 src/accelerator/ogl/image/shader.frag | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/accelerator/ogl/image/shader.frag b/src/accelerator/ogl/image/shader.frag
index 92a5fa9a6..d635308ae 100644
--- a/src/accelerator/ogl/image/shader.frag
+++ b/src/accelerator/ogl/image/shader.frag
@@ -666,7 +666,13 @@ vec3 apply_film_grain(vec3 c, vec2 uv, float intensity, float size_val, int fram
 {
     vec2  grain_uv = uv * target_size / max(size_val, 0.5);
     float noise    = grain_hash(grain_uv, frame_seed) * 2.0 - 1.0; // -1..+1
-    float lum      = dot(c, vec3(0.2126, 0.7152, 0.0722));
+    // dot(c.bgr, ...) -- c is BGR here, since this backend carries the pixel through
+    // the chain in the mixer's native BGR channel order (ContrastSaturationBrightness
+    // above already takes luma_coeff.bgr for the same reason). Unswizzled, the
+    // photographic response curve is driven by a luminance with red's Rec.709
+    // coefficient applied to blue, so grain lands in the wrong tonal range on
+    // saturated colour. Greys are unaffected by the exchange.
+    float lum      = dot(c.bgr, vec3(0.2126, 0.7152, 0.0722));
     float response = smoothstep(0.0, 0.15, lum) * (1.0 - smoothstep(0.8, 1.0, lum));
     c += vec3(noise * intensity * response);
     return c;
-- 
