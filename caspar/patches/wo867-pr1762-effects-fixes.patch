From a09a40f12a14833c4fc4ec8d5616f8cea39cf807 Mon Sep 17 00:00:00 2001
From: HighAsCG <mkoqaz13@gmail.com>
Date: Fri, 30 Oct 2026 15:04:29 +0100
Subject: [PATCH 2/2] =?UTF-8?q?fix(mixer):=20LENS=20blur=20luma=20on=20BGR?=
 =?UTF-8?q?=20+=20bounded=20sharpen/grain=20combine=20=E2=80=94=20port=20o?=
 =?UTF-8?q?f=20CasparCG/server#1762=2062fb8c2bf?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The upstream commit also carries the colour-grading series' grade_limits table (not in 2.5.1),
so only its two fixes are ported: the lens bokeh weight used Rec.601 on a BGR pixel (red and
blue exchanged; now Rec.709 on .bgr like the grain fix 5f99d1fcb), and combining transforms
took sharpen_radius / grain_size from a float test against the default and let the strengths
grow without bound (now keyed off the effect being on, clamped to the PR's ranges).
---
 src/accelerator/ogl/image/shader.frag   |  3 ++-
 src/accelerator/ogl/util/transforms.cpp | 14 ++++++++------
 2 files changed, 10 insertions(+), 7 deletions(-)

diff --git a/src/accelerator/ogl/image/shader.frag b/src/accelerator/ogl/image/shader.frag
index d635308ae..caad57aa9 100644
--- a/src/accelerator/ogl/image/shader.frag
+++ b/src/accelerator/ogl/image/shader.frag
@@ -631,7 +631,8 @@ vec4 get_blurred_color(vec2 uv)
             float theta  = dither_theta + float(i) * 2.39996323;
             vec2  offset = vec2(cos(theta), sin(theta)) * radius * texelSize;
             vec4  col    = get_rgba_color(uv + offset);
-            float lum    = dot(col.rgb, vec3(0.299, 0.587, 0.114));
+            // col is BGR here (see apply_film_grain): Rec.709 on .bgr, the same luma as the grain
+            float lum    = dot(col.bgr, vec3(0.2126, 0.7152, 0.0722));
             float weight = 1.0 + pow(max(lum - 0.3, 0.0), 3.0) * 15.0;
             weight      *= mix(0.3, 1.0, t);
             totalColor  += col * weight;
diff --git a/src/accelerator/ogl/util/transforms.cpp b/src/accelerator/ogl/util/transforms.cpp
index e82f0f286..d1fce9c5e 100644
--- a/src/accelerator/ogl/util/transforms.cpp
+++ b/src/accelerator/ogl/util/transforms.cpp
@@ -73,12 +73,14 @@ void apply_transform_colour_values(core::image_transform& self, const core::imag
     if (other.blur.enable) {
         self.blur = other.blur;
     }
-    self.sharpen_amount += other.sharpen_amount;
-    if (other.sharpen_radius != 1.0)
-        self.sharpen_radius = other.sharpen_radius;
-    self.grain_intensity += other.grain_intensity;
-    if (other.grain_size != 1.0)
-        self.grain_size = other.grain_size;
+    // Shape parameters come from whichever transform has the effect on (a float test against the default
+    // misreads a tweened 0.9999999), strengths clamp to what one command accepts (CasparCG/server#1762 62fb8c2bf).
+    self.sharpen_amount = std::clamp(self.sharpen_amount + other.sharpen_amount, 0.0, 5.0);
+    if (other.sharpen_amount != 0.0)
+        self.sharpen_radius = std::clamp(other.sharpen_radius, 0.1, 10.0);
+    self.grain_intensity = std::clamp(self.grain_intensity + other.grain_intensity, 0.0, 1.0);
+    if (other.grain_intensity != 0.0)
+        self.grain_size = std::clamp(other.grain_size, 0.5, 10.0);
 }
 
 bool is_default_perspective(const core::corners& perspective)
-- 
