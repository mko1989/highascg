+                case 0: { // long copy (l.710-741)
+                    uint32_t check = static_cast<uint32_t>(g.u8()) + 1;
+                    if (check == 256) {
+                        uint32_t probe;
+                        do {
+                            probe = g.le16();
+                            check += probe;
+                        } while (probe == 0xFFFF);
+                    }
+                    while (check && pos + 4 <= n) {
+                        copy_back(4);
+                        copy_back(4);
+                        copy_back(4);
+                        copy_back(4);
+                        check--;
+                    }
+                    continue;
+                }
+                case 1: { // new run value (l.742-760)
+                    run = g.u8();
+                    if (run == 255) {
+                        uint32_t probe;
+                        do {
+                            probe = g.le16();
+                            run += probe;
+                        } while (probe == 0xFFFF);
+                    }
+                    copy_back(4);
+                    copy_back(4);
+                    break;
+                }
+                case 2: // copy two words from a previous index (l.761-773)
+                    idx = 8 + 4 * static_cast<int64_t>(g.le16());
+                    if (idx > pos || (pos - idx) + 2 > n)
+                        return false;
+                    copy_back(idx);
+                    copy_back(idx);
+                    break;
+                default: // 3: two words from the input (l.774-783)
+                    wr32(tex + 4 * pos, g.le32());
+                    pos++;
+                    wr32(tex + 4 * pos, g.le32());
+                    pos++;
+                    break;
+            }
+        }
+
+        int op = checkpoint(g, value, state, idx, pos, 4);
+        if (op < 0)
+            return false;
+        if (pos + 2 > n)
+            return false;
+
+        if (op) {
+            if (idx > pos || (pos - idx) + 2 > n)
+                return false;
+            copy_back(idx);
+            copy_back(idx);
+        } else {
+            op = checkpoint(g, value, state, idx, pos, 4);
+            if (op < 0)
+                return false;
+            if (op && (idx > pos || (pos - idx) + 2 > n))
+                return false;
+            wr32(tex + 4 * pos, op ? rd32(tex + 4 * (pos - idx)) : g.le32());
+            pos++;
+
+            op = checkpoint(g, value, state, idx, pos, 4);
+            if (op < 0)
+                return false;
+            wr32(tex + 4 * pos, op ? rd32(tex + 4 * (pos - idx)) : g.le32());
+            pos++;
+        }
+    }
+    return true;
+}
