{
	"version": 2,
	"exfatRoot": "/home/casparcg/exfat",
	"volumes": {
		"bridge": {
			"id": "bridge",
			"label": "Bridge disk (HIGHASCGDAT)",
			"mount": "/home/casparcg/bridge",
			"mediaMount": "/home/casparcg/highascg/media/bridge"
		},
		"usb": {
			"id": "usb",
			"label": "USB stick (HIGHASCGEXF)",
			"mount": "/home/casparcg/exfat"
		}
	},
	"pairs": [
		{
			"id": "bridge-modular-config",
			"volume": "bridge",
			"label": "Bridge: modular settings + Caspar XML (configs/ ↔ config/)",
			"exfat": "configs",
			"project": "/home/casparcg/highascg/config",
			"direction": "both",
			"bootPrefer": "exfat",
			"pushOnSave": true,
			"exclude": []
		},
		{
			"id": "bridge-drop-config",
			"volume": "bridge",
			"label": "Bridge: optional monolithic highascg.config.json",
			"exfat": "drop-config/highascg.config.json",
			"project": "/home/casparcg/highascg/highascg.config.json",
			"direction": "both",
			"bootPrefer": "exfat",
			"pushOnSave": true,
			"exclude": []
		},
		{
			"id": "bridge-state-highascg",
			"volume": "bridge",
			"label": "Bridge: UI/state JSON at repo root",
			"exfat": "configs/.highascg-state.json",
			"project": "/home/casparcg/highascg/.highascg-state.json",
			"direction": "both",
			"bootPrefer": "exfat",
			"pushOnSave": true,
			"exclude": []
		},
		{
			"id": "bridge-state-module",
			"volume": "bridge",
			"label": "Bridge: module runtime state",
			"exfat": "configs/.module-state.json",
			"project": "/home/casparcg/highascg/.module-state.json",
			"direction": "both",
			"bootPrefer": "exfat",
			"pushOnSave": true,
			"exclude": []
		},
		{
			"id": "bridge-projects",
			"volume": "bridge",
			"label": "Bridge: show projects (projects/ ↔ working dir, mtime sync)",
			"exfat": "projects",
			"project": "/home/casparcg/highascg/projects",
			"direction": "both",
			"bootPrefer": "exfat"
		},
		{
			"id": "usb-modular-config",
			"volume": "usb",
			"label": "USB: modular settings (field prep)",
			"exfat": "configs",
			"project": "/home/casparcg/highascg/config",
			"direction": "to_project",
			"bootPrefer": "exfat",
			"pushOnSave": true,
			"exclude": []
		},
		{
			"id": "usb-drop-config",
			"volume": "usb",
			"label": "USB: optional monolithic highascg.config.json",
			"exfat": "drop-config/highascg.config.json",
			"project": "/home/casparcg/highascg/highascg.config.json",
			"direction": "to_project",
			"bootPrefer": "exfat",
			"pushOnSave": true,
			"exclude": []
		},
		{
			"id": "usb-state-highascg",
			"volume": "usb",
			"label": "USB: UI/state JSON",
			"exfat": "configs/.highascg-state.json",
			"project": "/home/casparcg/highascg/.highascg-state.json",
			"direction": "to_project",
			"bootPrefer": "exfat",
			"pushOnSave": true,
			"exclude": []
		},
		{
			"id": "usb-state-module",
			"volume": "usb",
			"label": "USB: module runtime state",
			"exfat": "configs/.module-state.json",
			"project": "/home/casparcg/highascg/.module-state.json",
			"direction": "to_project",
			"bootPrefer": "exfat",
			"pushOnSave": true,
			"exclude": []
		},
		{
			"id": "usb-projects",
			"volume": "usb",
			"label": "USB: show projects (stick → working dir at boot; per-save push only)",
			"exfat": "projects",
			"project": "/home/casparcg/highascg/projects",
			"direction": "to_project",
			"bootPrefer": "exfat"
		},
		{
			"id": "usb-media-ingest",
			"volume": "usb",
			"label": "USB: media field kit → playout library (one-way)",
			"exfat": "media",
			"project": "/home/casparcg/highascg/media/bridge",
			"direction": "to_project",
			"bootPrefer": "exfat",
			"exclude": []
		}
	]
}
