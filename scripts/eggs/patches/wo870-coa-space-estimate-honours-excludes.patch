diff --git a/coa/pkg/planner/exclude-match.go b/coa/pkg/planner/exclude-match.go
new file mode 100644
index 0000000..b073221
--- /dev/null
+++ b/coa/pkg/planner/exclude-match.go
@@ -0,0 +1,296 @@
+/*
+ * penguins-eggs - Copyright (C) 2017-2026 Piero Proietti
+ * Author: Piero Proietti <piero.proietti@gmail.com>
+ * https://penguins-eggs.net
+ *
+ * This file is part of penguins-eggs.
+ * Released under the GNU GPL v3 license.
+ */
+
+package planner
+
+import (
+	"strings"
+	"unicode"
+)
+
+// excludePattern is one line of the exclude list split into path components:
+// "var/log/!(journal)" -> ["var" "log" "!(journal)"].
+type excludePattern []string
+
+// parseExcludeList reads an exclude list the way `mksquashfs -wildcards -ef`
+// does (squashfs-tools 4.7, process_exclude_file + add_path): leading
+// whitespace is skipped, '#' lines are comments, one leading '\' is an escape,
+// components are split on '/' and empty components dropped (so a trailing '/'
+// changes nothing). A leading '/' is tolerated like the rest of coa does.
+//
+// "... " (non-anchored) lines are skipped: honouring them needs a walk of the
+// whole filesystem, and not subtracting them only makes the estimate safer.
+func parseExcludeList(data string) []excludePattern {
+	var patterns []excludePattern
+	for _, line := range strings.Split(data, "\n") {
+		line = strings.TrimLeftFunc(line, unicode.IsSpace)
+		if line == "" || strings.HasPrefix(line, "#") || strings.HasPrefix(line, "... ") {
+			continue
+		}
+		line = strings.TrimPrefix(line, "\\")
+		var pat excludePattern
+		for _, comp := range strings.Split(line, "/") {
+			if comp != "" {
+				pat = append(pat, comp)
+			}
+		}
+		if len(pat) > 0 {
+			patterns = append(patterns, pat)
+		}
+	}
+	return patterns
+}
+
+// fnmatchExt reports whether name (one path component) matches pattern like
+// glibc fnmatch(pattern, name, FNM_PATHNAME|FNM_PERIOD|FNM_EXTMATCH), the call
+// mksquashfs makes in excluded_match(): '*', '?', '[...]', '\' escapes and the
+// extglob groups ?(..) *(..) +(..) @(..) !(..). A leading '.' must be matched
+// explicitly ("root/*" does not match "root/.bashrc"; "root/.??*" does).
+func fnmatchExt(pattern, name string) bool {
+	return extMatch([]rune(pattern), []rune(name), true)
+}
+
+// extMatch matches p against all of s; period is true while s starts at the
+// beginning of the name (FNM_PERIOD).
+func extMatch(p, s []rune, period bool) bool {
+	for len(p) > 0 {
+		c := p[0]
+		if len(p) > 1 && p[1] == '(' && strings.ContainsRune("?*+@!", c) {
+			if alts, end := parseGroup(p, 1); end > 0 {
+				return extGroup(c, alts, p[end+1:], s, period)
+			}
+		}
+		switch c {
+		case '*':
+			if period && len(s) > 0 && s[0] == '.' {
+				return false
+			}
+			last := len(s)
+			if len(p) > 2 && p[2] == '(' && strings.ContainsRune("@+!", p[1]) {
+				last-- // like glibc: a group right after '*' never gets the empty tail
+			}
+			for i := 0; i <= last; i++ {
+				if extMatch(p[1:], s[i:], false) {
+					return true
+				}
+			}
+			return false
+		case '?':
+			if len(s) == 0 || (period && s[0] == '.') {
+				return false
+			}
+		case '[':
+			if len(s) == 0 || (period && s[0] == '.') {
+				return false
+			}
+			n, ok := matchBracket(p, s[0])
+			if n < 0 || (n > 0 && !ok) {
+				return false
+			}
+			if n > 0 {
+				p, s, period = p[n:], s[1:], false
+				continue
+			}
+			if s[0] != '[' { // unterminated bracket: a literal '['
+				return false
+			}
+		case '\\':
+			if len(p) == 1 { // a trailing '\' never matches
+				return false
+			}
+			p = p[1:]
+			c = p[0]
+			if len(s) == 0 || s[0] != c {
+				return false
+			}
+		default:
+			if len(s) == 0 || s[0] != c {
+				return false
+			}
+		}
+		p, s, period = p[1:], s[1:], false
+	}
+	return len(s) == 0
+}
+
+// extGroup matches an extglob group (kind is the character before '(')
+// followed by rest against s.
+func extGroup(kind rune, alts [][]rune, rest, s []rune, period bool) bool {
+	anyAlt := func(sub []rune, period bool) bool {
+		for _, a := range alts {
+			if extMatch(a, sub, period) {
+				return true
+			}
+		}
+		return false
+	}
+	switch kind {
+	case '!': // a prefix that matches none of the alternatives, then rest
+		for i := 0; i <= len(s); i++ {
+			if !anyAlt(s[:i], period) && extMatch(rest, s[i:], period && i == 0) {
+				return true
+			}
+		}
+	case '@', '?': // exactly one (or, for '?', zero or one) alternative
+		if kind == '?' && extMatch(rest, s, period) {
+			return true
+		}
+		for _, a := range alts { // glibc matches "<alternative><rest>" as one pattern
+			if extMatch(append(append([]rune{}, a...), rest...), s, period) {
+				return true
+			}
+		}
+	case '+', '*': // one (or, for '*', zero) or more alternatives
+		if extMatch(rest, s, period) && (kind == '*' || anyAlt(nil, period)) {
+			return true
+		}
+		for i := 1; i <= len(s); i++ {
+			if anyAlt(s[:i], period) &&
+				(extMatch(rest, s[i:], false) || extGroup('+', alts, rest, s[i:], false)) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// parseGroup splits the extglob group whose '(' is at p[open] into its
+// alternatives and returns the index of the closing ')', or -1 if the group is
+// invalid (the operator is then an ordinary character). Like glibc EXT(): '\'
+// is not special here, a bracket expression is skipped whole and only an
+// operator followed by '(' opens a nested group.
+func parseGroup(p []rune, open int) ([][]rune, int) {
+	var alts [][]rune
+	level, start := 0, open+1
+	for i := open + 1; i < len(p); i++ {
+		switch {
+		case p[i] == '[':
+			i++
+			if i < len(p) && (p[i] == '!' || p[i] == '^') {
+				i++
+			}
+			if i < len(p) && p[i] == ']' {
+				i++
+			}
+			for i < len(p) && p[i] != ']' {
+				i++
+			}
+			if i == len(p) {
+				return nil, -1
+			}
+		case strings.ContainsRune("?*+@!", p[i]) && i+1 < len(p) && p[i+1] == '(':
+			level++
+		case p[i] == ')' || p[i] == '|':
+			if level == 0 {
+				alts = append(alts, p[start:i])
+				start = i + 1
+				if p[i] == ')' {
+					return alts, i
+				}
+			} else if p[i] == ')' {
+				level--
+			}
+		}
+	}
+	return nil, -1
+}
+
+// matchBracket matches ch against the bracket expression starting at p[0]
+// ('['). It returns the length of the expression and whether ch is in the set.
+// For an unterminated expression it returns 0 ('[' is then a literal), or -1
+// when glibc gives up instead: a range or escape cut off by the pattern end.
+func matchBracket(p []rune, ch rune) (int, bool) {
+	i := 1
+	negate := i < len(p) && (p[i] == '!' || p[i] == '^')
+	if negate {
+		i++
+	}
+	matched := false
+	for first := true; i < len(p); first = false {
+		c := p[i]
+		if c == ']' && !first {
+			return i + 1, matched != negate
+		}
+		if c == '[' && i+1 < len(p) && p[i+1] == ':' {
+			if end := strings.Index(string(p[i+2:]), ":]"); end >= 0 {
+				class := string(p[i+2:])[:end]
+				matched = matched || inClass(class, ch)
+				i += 2 + len([]rune(class)) + 2
+				continue
+			}
+		}
+		if c == '[' && i+1 < len(p) && (p[i+1] == '.' || p[i+1] == '=') {
+			// collating symbol [.x.] or equivalence class [=x=]: one character
+			end := strings.Index(string(p[i+2:]), string(p[i+1])+"]")
+			if end < 0 {
+				return -1, false
+			}
+			sym := []rune(string(p[i+2:])[:end])
+			matched = matched || (len(sym) == 1 && sym[0] == ch)
+			i += 2 + len(sym) + 2
+			continue
+		}
+		if c == '\\' {
+			if i+1 == len(p) {
+				return -1, false
+			}
+			i++
+			c = p[i]
+		}
+		if i+1 < len(p) && p[i+1] == '-' && (i+2 == len(p) || p[i+2] != ']') {
+			if i+2 == len(p) {
+				return -1, false
+			}
+			hi := p[i+2]
+			i += 2
+			if hi == '\\' {
+				if i+1 == len(p) {
+					return -1, false
+				}
+				i++
+				hi = p[i]
+			}
+			matched = matched || (c <= ch && ch <= hi)
+		} else {
+			matched = matched || c == ch
+		}
+		i++
+	}
+	return 0, false
+}
+
+func inClass(class string, ch rune) bool {
+	switch class {
+	case "alpha":
+		return unicode.IsLetter(ch)
+	case "digit":
+		return ch >= '0' && ch <= '9'
+	case "alnum":
+		return unicode.IsLetter(ch) || unicode.IsDigit(ch)
+	case "upper":
+		return unicode.IsUpper(ch)
+	case "lower":
+		return unicode.IsLower(ch)
+	case "space":
+		return unicode.IsSpace(ch)
+	case "blank":
+		return ch == ' ' || ch == '\t'
+	case "punct":
+		return unicode.IsPunct(ch) || unicode.IsSymbol(ch)
+	case "xdigit":
+		return strings.ContainsRune("0123456789abcdefABCDEF", ch)
+	case "cntrl":
+		return unicode.IsControl(ch)
+	case "print":
+		return unicode.IsPrint(ch)
+	case "graph":
+		return unicode.IsGraphic(ch) && !unicode.IsSpace(ch)
+	}
+	return false
+}
