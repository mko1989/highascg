+package planner
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"golang.org/x/sys/unix"
+)
+
+// writeTree creates files (name -> size in KiB) under root.
+func writeTree(t *testing.T, root string, files map[string]int) {
+	t.Helper()
+	for name, kib := range files {
+		path := filepath.Join(root, name)
+		if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {
+			t.Fatalf("mkdir: %v", err)
+		}
+		if err := os.WriteFile(path, []byte(strings.Repeat("x", kib*1024)), 0644); err != nil {
+			t.Fatalf("write %s: %v", name, err)
+		}
+	}
+}
+
+// allocatedKiB sums st_blocks of the given paths (relative to root).
+func allocatedKiB(t *testing.T, root string, names ...string) uint64 {
+	t.Helper()
+	var bytes uint64
+	for _, name := range names {
+		var st unix.Stat_t
+		if err := unix.Lstat(filepath.Join(root, name), &st); err != nil {
+			t.Fatalf("lstat %s: %v", name, err)
+		}
+		bytes += uint64(st.Blocks) * 512
+	}
+	return bytes / 1024
+}
+
+func writeList(t *testing.T, lines ...string) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "excludes.list")
+	if err := os.WriteFile(path, []byte(strings.Join(lines, "\n")+"\n"), 0644); err != nil {
+		t.Fatalf("write list: %v", err)
+	}
+	return path
+}
+
+func TestMeasureExcludedKiBWildcards(t *testing.T) {
+	root := t.TempDir()
+	writeTree(t, root, map[string]int{
+		"home/user/media/clip.mov":   512,
+		"home/user/media/.hidden":    64,
+		"home/user/keep.txt":         32,
+		"var/log/syslog":             128,
+		"var/log/journal/system.log": 256,
+		"boot/grub/grub.cfg":         8,
+		"boot/grub/themes/bg.png":    16,
+	})
+	list := writeList(t,
+		"# the media is huge",
+		"home/*/media/*",
+		"var/log/!(apache2|journal)",
+		"boot/grub/!(themes|unicode.pf2)",
+		"does/not/exist",
+	)
+
+	got := measureExcludedKiB(root, list)
+	// media/* skips the dot file (FNM_PERIOD), !(...) keeps journal/ and themes/
+	want := allocatedKiB(t, root, "home/user/media/clip.mov", "var/log/syslog", "boot/grub/grub.cfg")
+	if got != want {
+		t.Fatalf("excluded = %d KiB, want %d KiB", got, want)
+	}
+}
+
+func TestMeasureExcludedKiBWholeTreeCountedOnce(t *testing.T) {
+	root := t.TempDir()
+	writeTree(t, root, map[string]int{
+		"data/a.bin":       100,
+		"data/sub/b.bin":   200,
+		"data/sub/.c.bin":  50,
+		"other/plain.file": 10,
+	})
+	// a hard link inside the same excluded tree must not be counted twice
+	if err := os.Link(filepath.Join(root, "data/a.bin"), filepath.Join(root, "data/sub/a-link.bin")); err != nil {
+		t.Fatalf("link: %v", err)
+	}
+	// a symlink to the big tree is excluded as a link, not followed
+	if err := os.Symlink(filepath.Join(root, "data"), filepath.Join(root, "other/data-link")); err != nil {
+		t.Fatalf("symlink: %v", err)
+	}
+	list := writeList(t,
+		"data/",
+		"data/sub/*", // nested in an excluded tree: no double count
+		"other/data-link",
+		"other/data-link/*",
+	)
+
+	got := measureExcludedKiB(root, list)
+	want := allocatedKiB(t, root, "data", "data/a.bin", "data/sub", "data/sub/b.bin", "data/sub/.c.bin", "other/data-link")
+	if got != want {
+		t.Fatalf("excluded = %d KiB, want %d KiB", got, want)
+	}
+}
+
+func TestMeasureExcludedKiBStaysOnRootFilesystem(t *testing.T) {
+	var rootStat, procStat unix.Stat_t
+	if unix.Lstat("/", &rootStat) != nil || unix.Lstat("/proc/self", &procStat) != nil || rootStat.Dev == procStat.Dev {
+		t.Skip("needs /proc mounted as a separate filesystem")
+	}
+	// proc/* lives on another filesystem: not part of the root used space
+	if got := measureExcludedKiB("/", writeList(t, "proc/*", "proc")); got != 0 {
+		t.Fatalf("excluded = %d KiB on /proc, want 0", got)
+	}
+}
+
+func TestCheckDiskSpaceReportsMeasuredExcludes(t *testing.T) {
+	work := t.TempDir()
+	report, err := CheckDiskSpace(work, work, "xz", writeList(t, "no/such/path/anywhere"))
+	if err != nil {
+		t.Fatalf("CheckDiskSpace: %v", err)
+	}
+	if report.ExcludedKiB != 0 {
+		t.Fatalf("excluded = %d KiB, want 0", report.ExcludedKiB)
+	}
+	if !strings.Contains(report.String(), "Excluded:") || !strings.Contains(report.String(), "measured in") {
+		t.Fatalf("report does not show the measured exclude size:\n%s", report.String())
+	}
+}
