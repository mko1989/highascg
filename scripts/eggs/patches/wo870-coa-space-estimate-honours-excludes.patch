+// addTree adds the allocated size of path and, for a directory, its whole
+// subtree on the same filesystem.
+func (m *excludeMeter) addTree(path string) {
+	filepath.WalkDir(path, func(p string, d fs.DirEntry, err error) error {
+		var st unix.Stat_t
+		if err != nil || unix.Lstat(p, &st) != nil {
+			return nil
+		}
+		isDir := st.Mode&unix.S_IFMT == unix.S_IFDIR
+		if uint64(st.Dev) != m.dev {
+			if isDir {
+				return filepath.SkipDir
+			}
+			return nil
+		}
