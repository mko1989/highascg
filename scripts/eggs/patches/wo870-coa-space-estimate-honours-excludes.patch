+
+package planner
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestFnmatchExt(t *testing.T) {
+	cases := []struct {
+		pattern, name string
+		want          bool
+	}{
+		// plain wildcards, FNM_PERIOD: a leading dot is never matched by a wildcard
+		{"*", "foo", true},
+		{"*", ".bashrc", false},
+		{".??*", ".ab", true},
+		{".??*", ".a", false},
+		{"*.iso", "egg.iso", true},
+		{"*.iso", "egg.img", false},
+		{"*.iso", ".iso", false},
+		{"ssh_host_*", "ssh_host_ed25519_key", true},
+		{"*cryptdisks*", "S01cryptdisks-early", true},
+		{"*-old", "status-old", true},
+		{"**", "anything", true},
+		{"?", "a", true},
+		{"?", ".", false},
+		{"?", "ab", false},
+		// brackets and escapes
+		{"[a-c]x", "bx", true},
+		{"[a-c]x", "dx", false},
+		{"[!a]x", "ax", false},
+		{"[!a]x", "bx", true},
+		{"[]]", "]", true},
+		{"[[:digit:]]*", "5abc", true},
+		{"[[:digit:]]*", "abc", false},
+		{"[unterminated", "[unterminated", true},
+		{"\\*", "*", true},
+		{"\\*", "a", false},
+		// extglob, as used by the built-in list
+		{"!(themes|unicode.pf2)", "grub.cfg", true},
+		{"!(themes|unicode.pf2)", "themes", false},
+		{"!(themes|unicode.pf2)", "unicode.pf2", false},
+		{"!(themes|unicode.pf2)", "themes.bak", true},
+		{"!(apache2|clamav|libvirt|journal|samba)", "syslog", true},
+		{"!(apache2|clamav|libvirt|journal|samba)", "journal", false},
+		{"@(a|b)c", "bc", true},
+		{"@(a|b)c", "cc", false},
+		{"+(ab)", "abab", true},
+		{"+(ab)", "", false},
+		{"*(ab)", "", true},
+		{"*(ab)x", "ababx", true},
+		{"?(x)y", "y", true},
+		{"?(x)y", "xy", true},
+		{"?(x)y", "xxy", false},
+		{"foo.!(bak)", "foo.conf", true},
+		{"foo.!(bak)", "foo.bak", false},
+		// glibc corner cases, checked against fnmatch(3) of glibc 2.43
+		{"*!(x)", "x", false},       // a group right after '*' never gets the empty tail
+		{"+(\\[)", "+(\\[)", false}, // unterminated bracket inside a group: invalid group, literal '+'
+		{"[a-", "[a-", false},       // range cut off by the end of the pattern
+		{"x\\", "x\\", false},       // trailing backslash
+		{"[[.a.]]", "a", true},      // collating symbol
+	}
+	for _, c := range cases {
+		if got := fnmatchExt(c.pattern, c.name); got != c.want {
+			t.Errorf("fnmatchExt(%q, %q) = %v, want %v", c.pattern, c.name, got, c.want)
+		}
+	}
+}
+
+func TestParseExcludeList(t *testing.T) {
+	data := "# comment\n" +
+		"\n" +
+		"  var/lib/docker/\n" +
+		"/etc/fstab\n" +
+		"home//*/.cache/*\n" +
+		"\\#odd name\n" +
+		"... sticky\n" +
+		"boot/grub/!(themes|unicode.pf2)\n"
+	want := []excludePattern{
+		{"var", "lib", "docker"},
+		{"etc", "fstab"},
+		{"home", "*", ".cache", "*"},
+		{"#odd name"},
+		{"boot", "grub", "!(themes|unicode.pf2)"},
+	}
+	if got := parseExcludeList(data); !reflect.DeepEqual(got, want) {
+		t.Fatalf("parseExcludeList:\n got %q\nwant %q", got, want)
+	}
+}
