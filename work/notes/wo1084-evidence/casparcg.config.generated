<configuration>
    <paths>
        <media-path>media/</media-path>
        <log-path disable="false">log/</log-path>
        <data-path>data/</data-path>
        <template-path>template/</template-path>
    </paths>
    <lock-clear-phrase>secret</lock-clear-phrase>
    <log-level>info</log-level>
    <system-audio>
        <device-name/>
    </system-audio>
    <portaudio>
        <device-name>hw:0,0</device-name>
        <device>hw:0,0</device>
        <host-api>auto</host-api>
        <output-channels>2</output-channels>
        <channels>2</channels>
        <buffer-size-frames>128</buffer-size-frames>
        <latency-compensation-ms>40</latency-compensation-ms>
        <auto-tune-latency>true</auto-tune-latency>
        <fifo-ms>50</fifo-ms>
    </portaudio>
    <!-- HighAsCG: Each channel block starts with a comment naming its Caspar index and role (PGM program, PRV preview, DeckLink inputs host, multiview, streaming, monitor). -->
    <channels>
        <!-- HighAsCG: Caspar channel 1: Operator GUI channel "Operator GUI" — SHARED MEMORY /dev/shm/highascg-opgui for the native client (WO-593/594); routed preview layers (10-49) unchanged -->
        <channel>
            <video-mode>1080p5000</video-mode>
            <consumers>
                <shm>
                    <name>opgui</name>
                </shm>
            </consumers>
            <mixer>
                <audio-osc>true</audio-osc>
            </mixer>
        </channel>
        <!-- HighAsCG: Caspar channel 2: Screen 1 program output (PGM) -->
        <channel>
            <video-mode>3072x1024</video-mode>
            <channel-layout>stereo</channel-layout>
            <consumers>
                <screen>
                    <device>1</device>
                    <stretch>none</stretch>
                    <windowed>true</windowed>
                    <key-only>false</key-only>
                    <vsync>false</vsync>
                    <borderless>true</borderless>
                    <interactive>true</interactive>
                    <always-on-top>true</always-on-top>
                    <x>0</x><y>0</y>
                    <width>3072</width><height>1024</height>
                    <sbs-key>false</sbs-key>
                    <colour-space>RGB</colour-space>
                    <force-linear-filter>false</force-linear-filter>
                    <high-bitdepth>false</high-bitdepth>
                    <gpu-texture>true</gpu-texture>
                </screen>
                <portaudio/>
            </consumers>
            <mixer>
                <audio-osc>true</audio-osc>
            </mixer>
        </channel>
        <!-- HighAsCG: Caspar channel 3: Screen 1 preview output (PRV) -->
        <channel>
            <video-mode>3072x1024</video-mode>
            <consumers></consumers>
            <mixer>
                <audio-osc>true</audio-osc>
            </mixer>
        </channel>
        <!-- HighAsCG: Caspar channel 4: Screen 2 program output (PGM) -->
        <channel>
            <video-mode>3072x1024</video-mode>
            <channel-layout>stereo</channel-layout>
            <consumers>
                <screen>
                    <device>2</device>
                    <stretch>none</stretch>
                    <windowed>true</windowed>
                    <key-only>true</key-only>
                    <vsync>false</vsync>
                    <borderless>true</borderless>
                    <interactive>false</interactive>
                    <always-on-top>true</always-on-top>
                    <x>3072</x><y>0</y>
                    <width>3072</width><height>1024</height>
                    <sbs-key>false</sbs-key>
                    <colour-space>RGB</colour-space>
                    <force-linear-filter>false</force-linear-filter>
                    <high-bitdepth>false</high-bitdepth>
                    <gpu-texture>true</gpu-texture>
                </screen>
                <screen>
                    <device>61</device>
                    <stretch>none</stretch>
                    <windowed>true</windowed>
                    <key-only>false</key-only>
                    <vsync>false</vsync>
                    <borderless>true</borderless>
                    <interactive>true</interactive>
                    <always-on-top>true</always-on-top>
                    <x>6144</x><y>0</y>
                    <width>3072</width><height>1024</height>
                    <sbs-key>false</sbs-key>
                    <colour-space>RGB</colour-space>
                    <force-linear-filter>false</force-linear-filter>
                    <high-bitdepth>false</high-bitdepth>
                    <gpu-texture>true</gpu-texture>
                </screen>
            </consumers>
            <mixer>
                <audio-osc>true</audio-osc>
            </mixer>
        </channel>
        <!-- HighAsCG: Caspar channel 5: DeckLink input 1 (PLAY 5-1 DECKLINK <device>; dedicated channel, isolated VU) -->
        <channel>
            <video-mode>1080p5000</video-mode>
            <channel-layout>stereo</channel-layout>
            <consumers>
            </consumers>
            <mixer>
                <audio-osc>true</audio-osc>
            </mixer>
        </channel>
        <!-- HighAsCG: Caspar channel 6: DeckLink input 2 (PLAY 6-2 DECKLINK <device>; dedicated channel, isolated VU) -->
        <channel>
            <video-mode>1080p5000</video-mode>
            <channel-layout>stereo</channel-layout>
            <consumers>
            </consumers>
            <mixer>
                <audio-osc>true</audio-osc>
            </mixer>
        </channel>
        <!-- HighAsCG: Caspar channel 7: DeckLink input 3 (PLAY 7-3 DECKLINK <device>; dedicated channel, isolated VU) -->
        <channel>
            <video-mode>1080p5000</video-mode>
            <channel-layout>stereo</channel-layout>
            <consumers>
            </consumers>
            <mixer>
                <audio-osc>true</audio-osc>
            </mixer>
        </channel>
        <!-- HighAsCG: Caspar channel 8: Live audio input 1 (ALSA PLAY … alsa:// on layer 10; cheap channel, isolated VU) -->
        <channel>
            <video-mode>64x36</video-mode>
            <channel-layout>stereo</channel-layout>
            <consumers>
            </consumers>
            <mixer>
                <audio-osc>true</audio-osc>
            </mixer>
        </channel>
        <!-- HighAsCG: Caspar channel 9: Monitor / headphone mix (system-audio consumer) -->
        <channel>
            <video-mode>64x36</video-mode>
            <consumers>
                <system-audio>
                    <device-name>hw:2,0</device-name>
                </system-audio>
            </consumers>
            <mixer>
                <audio-osc>true</audio-osc>
            </mixer>
        </channel>
    </channels>
    <video-modes>
        <video-mode>
            <id>3072x1024</id>
            <width>3072</width>
            <height>1024</height>
            <time-scale>50000</time-scale>
            <duration>1000</duration>
            <cadence>960</cadence>
        </video-mode>
        <video-mode>
            <id>64x36</id>
            <width>64</width>
            <height>36</height>
            <time-scale>50000</time-scale>
            <duration>1000</duration>
            <cadence>960</cadence>
        </video-mode>
    </video-modes>
    <controllers><tcp><port>5250</port><protocol>AMCP</protocol></tcp>
    </controllers>
    <osc>
        <default-port>6250</default-port>
        <disable-send-to-amcp-clients>false</disable-send-to-amcp-clients>
        <predefined-clients>
            <predefined-client>
                <address>127.0.0.1</address>
                <port>6251</port>
            </predefined-client>
        </predefined-clients>
    </osc>

    <amcp><media-server><host>localhost</host><port>8000</port></media-server></amcp>
    <ndi><auto-load>true</auto-load></ndi>
    <decklink/>
    <!-- HighAsCG WO-790: decoder threads per file. Caspar's default (0 = one per core) fills that many frame threads before the first picture of a seek (~50 ms on 4K NotchLC); 4 still decodes 4K NotchLC / ProRes / H.264 50p several times faster than real time. -->
    <ffmpeg><producer><threads>4</threads></producer></ffmpeg>
    <html>
        <enable-gpu>false</enable-gpu>
        <remote-debugging-port>9222</remote-debugging-port>
    </html>
</configuration>