; WO-745 — HighAsCG Retro: the operator's game window (a libretro core through RetroHost); its picture is published
; as a shared-memory ring (HshmSink) that the Live tab offers as a source (WO-744). Separate from the kiosk client on
; purpose: a core that crashes takes only this window down. Run: godot/retro/run-retro.sh --core … --game … [--ring …]
config_version=5

[application]

config/name="HighAsCG Retro"
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=960
window/size/viewport_height=720
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
