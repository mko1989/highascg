extends RefCounted
## WO-605 — cable_model.gd golden test against the web original client/components/device-view-cables-physics.js:
## colour hash, id seed, hash_id values, and the full build() polyline (point count exact, x/y within 0.01 px).
## Goldens were produced by running that JS module under Node with the inputs named in each test.

const M := preload("res://features/devices/cable_model.gd")
const TOL := 0.01
var t


func _check_build(id: String, x1: float, y1: float, x2: float, y2: float, loops: int, golden: Array, what: String) -> void:
	var pts: PackedVector2Array = M.build(x1, y1, x2, y2, loops, M.seed_of(id))
	var n: int = golden.size() >> 1
	t.eq(pts.size(), n, "%s point count" % what)
	for i in mini(pts.size(), n):
		var gx: float = golden[2 * i]
		var gy: float = golden[2 * i + 1]
		t.ok(absf(pts[i].x - gx) < TOL and absf(pts[i].y - gy) < TOL,
			"%s point %d expected (%s, %s) got (%s, %s)" % [what, i, gx, gy, pts[i].x, pts[i].y])


func test_color_hex_golden() -> void:
	for row in COLOR_GOLDEN:
		t.eq(M.color_hex(row[0]), row[1], "colour of id %s" % str(row[0]))


func test_color_empty_id_is_neutral() -> void:
	t.eq(M.color_hex(""), "#94a3b8", "empty id gets the no-id colour")


func test_hash_id_and_seed_match_js() -> void:
	for row in HASH_GOLDEN:
		t.eq(M.hash_id(row[0]), row[1], "JS (h << 5) - h + c hash of %s" % str(row[0]))
		t.eq(M.seed_of(row[0]), row[2], "char-code sum seed of %s" % str(row[0]))


func test_build_short_loops2() -> void:
	# dist ~45 px (< 70): loops 2 gives no coils
	_check_build("g_short", 100.0, 100.0, 140.0, 120.0, 2, G_SHORT, "short loops 2")


func test_build_mid_loops1() -> void:
	# dist ~103 px (>= 90): loops 1 gives one coil
	_check_build("g_mid_1", 200.0, 100.0, 290.0, 150.0, 1, G_MID_1, "mid loops 1")


func test_build_mid_loops2() -> void:
	# dist ~103 px (70..120): loops 2 gives one coil
	_check_build("g_mid_2", 300.0, 200.0, 390.0, 250.0, 2, G_MID_2, "mid loops 2")


func test_build_long_down_right_loops0() -> void:
	# dist ~540 px, down-right, no coils
	_check_build("g_long_dr0", 50.0, 50.0, 500.0, 350.0, 0, G_LONG_DR0, "long down-right loops 0")


func test_build_long_up_left_loops2() -> void:
	# dist ~640 px, up-left, two coils
	_check_build("g_long_ul2", 700.0, 500.0, 200.0, 100.0, 2, G_LONG_UL2, "long up-left loops 2")


func test_build_long_loops1() -> void:
	# dist ~510 px, down-right, one coil
	_check_build("g_long_1", 100.0, 80.0, 600.0, 420.0, 1, G_LONG_1, "long loops 1")


