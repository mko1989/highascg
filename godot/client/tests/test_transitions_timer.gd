extends RefCounted
## WO-600 I/O — golden values generated by running the real client JS (transition-presets.js,
## transition-duration.js, playback-timer-format.js) under node on 2026-10-17. Do not edit by hand.

const T := preload("res://features/live/transitions.gd")
const P := preload("res://features/live/pgm_timer_model.gd")
var t


func test_pgm_only_normalize_golden() -> void:
	var cases := [[{"type": "MIX", "duration": 25, "tween": "linear"}, {"type": "MIX + ANIMATE", "duration": 25, "tween": "linear"}], [{"type": "MIX", "duration": 0}, {"type": "MIX + ANIMATE", "duration": 25, "tween": "linear"}], [{"type": "WIPE", "duration": 12, "tween": "easein"}, {"type": "WIPE + ANIMATE", "duration": 12, "tween": "easein"}], [{"type": "CUT", "duration": 30}, {"type": "CUT", "duration": 0, "tween": "linear"}], [{"type": "MIX + ANIMATE", "duration": 10}, {"type": "MIX + ANIMATE", "duration": 10, "tween": "linear"}], [{"type": "MIX + MERGE", "duration": 8}, {"type": "CUT", "duration": 0, "tween": "linear"}], [{"type": "MIX+ ANIMATE", "duration": 25}, {"type": "CUT", "duration": 0, "tween": "linear"}], [{"type": "BOGUS", "duration": 5}, {"type": "CUT", "duration": 0, "tween": "linear"}], [null, {"type": "CUT", "duration": 0, "tween": "linear"}], [{"duration": 7.6, "type": "SLIDE"}, {"type": "SLIDE + ANIMATE", "duration": 8, "tween": "linear"}]]
	for c in cases:
		var got := T.normalize_for_pgm_only(c[0])
		var want: Dictionary = c[1]
		t.ok(got.type == want.type and int(got.duration) == int(want.duration) and got.tween == want.tween, "pgm-only %s → %s (got %s)" % [c[0], want, got])


func test_migrate_golden() -> void:
	for c in [["MIX + MERGE", "MIX+ ANIMATE"], ["wipe+merge", "wipe+ ANIMATE"], ["SLIDE  +  MERGE", "SLIDE+ ANIMATE"], ["PUSH", "PUSH"], [null, ""]]:
		t.eq(T.migrate_type(c[0]), c[1], "migrate %s" % c[0])


func test_duration_golden() -> void:
	for c in [[12, 50, 25, true], [12, 25, 13, true], [12, 30, 15, true], [25, 50, 25, false], [0, 50, 0, false], ["x", 60, 30, true], [7.6, 50, 8, false], [12, 0, 25, true]]:
		t.eq(T.resolve_duration(c[0], c[1]), int(c[2]), "resolve %s @%s fps" % [c[0], c[1]])
		t.eq(T.is_auto_duration(c[0]), c[3], "auto? %s" % c[0])
	for c in [[50, 25], [25, 13], [29.97, 15], [60, 30], [0, 25], [-1, 25], [1, 1]]:
		t.eq(T.duration_for_fps(c[0]), int(c[1]), "for fps %s" % c[0])


func test_formats_golden() -> void:
	for c in [[0, 50, "00:00:00:00", "0:00"], [61.5, 50, "00:01:01:25", "1:01"], [3725.98, 25, "01:02:05:24", "62:05"], [-1, 50, "--:--:--:--", "--:--"], [59.999, 50, "00:00:59:49", "0:59"], [1.02, 0, "00:00:01:01", "0:01"]]:
		t.eq(P.format_hmsf(float(c[0]), float(c[1])), c[2], "hmsf %s @%s" % [c[0], c[1]])
		t.eq(P.format_mmss(float(c[0])), c[3], "mmss %s" % c[0])


## Same inputs/expectations as tools/smoke/smoke-wo250-timer-bank-mv-bars.test.js and smoke-wo297-idle-top-layer-footer.test.js.
func test_top_layer_pick_like_wo250() -> void:
	var now := 1_000_000.0
	var ch := {"layers": {"10": {"_lastOscAt": now - 20000, "file": {"name": "old-a.mov", "duration": 5, "elapsed": 2}}, "110": {"_lastOscAt": now, "file": {"name": "new-b.mov", "duration": 5, "elapsed": 1}}}}
	t.eq(P.pick_top_layer(ch, "b", now).layer, 110, "bank b: live 110 over stale 10")
	ch = {"layers": {"10": {"_lastOscAt": now, "file": {"duration": 5, "elapsed": 1}}, "110": {"_lastOscAt": now - 3000, "file": {"duration": 5, "elapsed": 4}}}}
	t.eq(P.pick_top_layer(ch, "a", now).layer, 10, "bank a: 110 out of range")
	ch = {"layers": {"20": {"_lastOscAt": now - 20000, "file": {"duration": 5, "elapsed": 4}}, "15": {"_lastOscAt": now, "file": {"duration": 5, "elapsed": 1}}}}
	t.eq(P.pick_top_layer(ch, "a", now).layer, 15, "stale 20 skipped")
	ch = {"layers": {"985": {"_lastOscAt": now, "file": {"duration": 5, "elapsed": 1}}, "998": {"_lastOscAt": now, "file": {"duration": 5, "elapsed": 1}}}}
	t.eq(P.pick_top_layer(ch, "a", now).layer, null, "timer band + border excluded")
	ch = {"layers": {"15": {"_lastOscAt": now, "file": {"duration": 5, "elapsed": 1}}, "115": {"_lastOscAt": now, "file": {"duration": 5, "elapsed": 1}}}}
	t.eq(P.pick_top_layer(ch, null, now).layer, 15, "bankless → 10-99")
	ch = {"layers": {"20": {"type": "route", "file": {"name": "route://2", "elapsed": 1}}, "12": {"file": {"elapsed": 3, "duration": 9}}}}
	t.eq(P.pick_top_layer(ch, null, now).layer, 12, "route layers are wiring, never the top layer")


func test_idle_labels_like_wo297() -> void:
	t.eq(P.idle_label({"type": "empty", "file": {"name": "stale.mp4"}}), "", "empty producer → no label")
	t.eq(P.idle_label(null), "", "null")
	t.eq(P.idle_label({"type": "ffmpeg", "file": {"path": "C:\\media\\clips\\SLIDE.png"}}), "SLIDE.png", "path basename")
	t.eq(P.idle_label({"type": "html", "file": {}, "template": {"path": "/opt/templates/lower-third.html"}}), "lower-third.html", "template basename")
	t.eq(P.idle_label({"type": "decklink", "file": {}}), "decklink", "producer type")
	var out := P.idle_label({"type": "ffmpeg", "file": {"name": "A".repeat(80) + ".mp4"}})
	t.ok(out.length() <= 32 and out.ends_with("…"), "truncated to 32 with …")
	t.eq(P.tier(22.0), "green", "tier >10")
	t.eq(P.tier(7.0), "orange", "tier 5-10")
	t.eq(P.tier(5.0), "red", "tier ≤5")
	t.eq(P.tier(null), "muted", "no remaining")


func test_merge_channel_keeps_file_fields() -> void:
	var a := {"layers": {"10": {"file": {"duration": 60.0, "elapsed": 1.0}, "type": "ffmpeg"}}}
	var b := {"layers": {"10": {"file": {"elapsed": 2.0}}}}
	var m := P.merge_channel(a, b)
	t.eq(m.layers["10"].file.duration, 60.0, "delta keeps duration")
	t.eq(m.layers["10"].file.elapsed, 2.0, "delta updates elapsed")
	t.eq(m.layers["10"].type, "ffmpeg", "other layer fields kept")



## WO-604 — web mergeChannel: meter slots merge slot-wise; the delta's slot count wins.
func test_merge_channel_audio_levels_slotwise() -> void:
	var a := {"audio": {"nbChannels": 2, "levels": [{"dBFS": -10.0, "peak": -3.0}, {"dBFS": -12.0, "peak": -4.0}]}}
	var b := {"audio": {"levels": [{"dBFS": -120.0}]}}
	var m := P.merge_channel(a, b)
	t.eq(m.audio.nbChannels, 2, "other audio fields kept")
	t.eq(m.audio.levels.size(), 1, "the delta's slot list wins")
	t.eq(m.audio.levels[0].dBFS, -120.0, "fresh dBFS replaces the stale one")
	t.eq(m.audio.levels[0].peak, -3.0, "fields the delta omits are kept")
	t.eq(a.audio.levels[0].dBFS, -10.0, "the old snapshot is not mutated")
	t.eq(P.merge_channel({}, {"audio": {"levels": [{"dBFS": -5.0}]}}).audio.levels[0].dBFS, -5.0, "no previous audio")
