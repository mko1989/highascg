extends RefCounted
## WO-600 I — 1:1 port of client/lib/transition-presets.js + transition-duration.js (pure).
## Stored duration 12 = "auto: half the project fps" (AUTO_TRANSITION_DURATION_SENTINEL).
## Golden-tested against the JS (tests/test_transitions.gd, values generated by running the JS).

const AUTO_SENTINEL := 12
const DEFAULT := {"type": "CUT", "duration": 0, "tween": "linear"}
const TYPES := ["CUT", "MIX", "PUSH", "WIPE", "SLIDE", "MIX + ANIMATE", "WIPE + ANIMATE", "SLIDE + ANIMATE", "PUSH + ANIMATE"]
const TWEENS := ["linear", "easein", "easeout", "easeboth"]
const LABELS := {"CUT": "CUT", "MIX": "MIX", "PUSH": "PUSH", "WIPE": "WIPE", "SLIDE": "SLIDE",
	"MIX + ANIMATE": "MIX + Animate", "WIPE + ANIMATE": "Wipe + Animate", "SLIDE + ANIMATE": "Slide + Animate", "PUSH + ANIMATE": "Push + Animate"}
## PGM-only outputs have no PRV bus — plain MIX/WIPE/SLIDE/PUSH are not supported on take.
const PGM_ONLY_TYPES := ["CUT", "MIX + ANIMATE", "WIPE + ANIMATE", "SLIDE + ANIMATE", "PUSH + ANIMATE"]
const PLAIN_TO_ANIMATE := {"MIX": "MIX + ANIMATE", "PUSH": "PUSH + ANIMATE", "WIPE": "WIPE + ANIMATE", "SLIDE": "SLIDE + ANIMATE"}


## Web `defaultTransition(fps)` (scene-state-helpers.js): MIX, auto duration unless fps is given.
static func default_transition(fps: Variant = null) -> Dictionary:
	return {"type": "MIX", "duration": duration_for_fps(fps) if fps != null else AUTO_SENTINEL, "tween": "linear"}


## Legacy "+ MERGE" spelling → " + ANIMATE" (same-layer animate path). WO-843: the replacement carries its own leading
## space — the pattern eats the whitespace before "+", so "+ ANIMATE" turned "MIX + MERGE" into "MIX+ ANIMATE", a type
## in no list, which normalize_for_pgm_only then made a CUT (the JS original had the same slip; the old golden pinned it).
static func migrate_type(t: Variant) -> String:
	var s := "" if t == null else str(t)
	var re := RegEx.create_from_string("(?i)\\s*\\+\\s*MERGE\\b")
	return re.sub(s, " + ANIMATE", true).strip_edges()


static func normalize_for_pgm_only(t: Variant) -> Dictionary:
	var base := DEFAULT.duplicate()
	if t is Dictionary:
		base.merge(t as Dictionary, true)
	var type := migrate_type(base.get("type"))
	var tween: Variant = base.get("tween")
	var tw: String = str(tween) if tween != null and str(tween) != "" else "linear"
	if type == "CUT":
		return {"type": "CUT", "duration": 0, "tween": tw}
	var dur := maxi(0, _js_round(_num_or_zero(base.get("duration"))))
	if PGM_ONLY_TYPES.has(type):
		return {"type": type, "duration": dur, "tween": tw}
	if PLAIN_TO_ANIMATE.has(type):
		return {"type": PLAIN_TO_ANIMATE[type], "duration": dur if dur > 0 else duration_for_fps(50), "tween": tw}
	return {"type": "CUT", "duration": 0, "tween": "linear"}


static func duration_for_fps(fps: Variant) -> int:
	var n := _num(fps)
	var rate := n if not is_nan(n) and n > 0.0 else 50.0
	return maxi(1, _js_round(rate / 2.0))


static func is_auto_duration(d: Variant) -> bool:
	var n := _num(d)
	return is_nan(n) or is_inf(n) or _js_round(n) == AUTO_SENTINEL


static func resolve_duration(d: Variant, fps: Variant) -> int:
	if is_auto_duration(d):
		return duration_for_fps(fps)
	return maxi(0, _js_round(_num(d)))


## Number(v) — NaN for non-numeric; null → 0 (as JS).
static func _num(v: Variant) -> float:
	if v == null:
		return 0.0
	if v is int or v is float:
		return float(v)
	var s := str(v).strip_edges()
	return float(s) if s.is_valid_float() else NAN


static func _num_or_zero(v: Variant) -> float:
	var n := _num(v)
	return 0.0 if is_nan(n) else n


## Math.round: half rounds towards +∞.
static func _js_round(x: float) -> int:
	return int(floor(x + 0.5))
