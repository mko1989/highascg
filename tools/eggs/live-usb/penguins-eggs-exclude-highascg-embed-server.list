# HighAsCG — omit dev trees from squashfs; keep server runtime on ISO (standalone boot).
# Use with HIGHASCG_ISO_EMBED_SERVER=1 in prepare-eggs-clone-with-exfat.sh
# See docs/WO47_ISO_VS_EXFAT.md (exFAT drop-update/ still applies when stick present)

swap.img
swapfile

# ISO build tooling — not needed on playout live system
usr/lib/penguins-eggs
usr/lib/penguins-eggs/*

# Kernel/NVIDIA headers — build host only
usr/src
usr/src/*

opt/nvidia-pool
opt/nvidia-pool/*

# Browser UI sources (Vite build inputs — not served on playout; dist-web/ is baked on ISO)
home/casparcg/highascg/client
home/casparcg/highascg/client/*
home/casparcg/highascg/deprecated
home/casparcg/highascg/deprecated/*
home/casparcg/highascg/work
home/casparcg/highascg/work/*
home/casparcg/highascg/examples
home/casparcg/highascg/examples/*
home/casparcg/highascg/samples
home/casparcg/highascg/samples/*
home/casparcg/highascg/scratch
home/casparcg/highascg/scratch/*
home/casparcg/highascg/audio_testing
home/casparcg/highascg/audio_testing/*
home/casparcg/highascg/for_client
home/casparcg/highascg/for_client/*
home/casparcg/highascg/From_client
home/casparcg/highascg/From_client/*
home/casparcg/highascg/.git
home/casparcg/highascg/.git/*
home/casparcg/highascg/.reference
home/casparcg/highascg/.reference/*
home/casparcg/highascg/docs
home/casparcg/highascg/docs/*
home/casparcg/highascg/lib/libcef_dll
home/casparcg/highascg/lib/libcef_dll/*

# tools/ except runtime/ (exfat-sync, Caspar helpers)
home/casparcg/highascg/tools/eggs
home/casparcg/highascg/tools/eggs/*
home/casparcg/highascg/tools/smoke
home/casparcg/highascg/tools/smoke/*
home/casparcg/highascg/tools/release
home/casparcg/highascg/tools/release/*
home/casparcg/highascg/tools/restore
home/casparcg/highascg/tools/restore/*

# Runtime under ~/highascg (stubs stay on ISO)
home/casparcg/highascg/media/*
home/casparcg/highascg/_media
home/casparcg/highascg/log
home/casparcg/highascg/log/*
home/casparcg/highascg/cef-cache
home/casparcg/highascg/cef-cache/*
home/casparcg/highascg/.env
home/casparcg/highascg/data
home/casparcg/highascg/data/*
home/casparcg/highascg/refs
home/casparcg/highascg/dist
home/casparcg/highascg/.github
home/casparcg/highascg/.github/*

# exFAT mountpoint (empty in ISO)
home/casparcg/exfat
home/casparcg/exfat/*

# casparcg build-host dotfiles (not .xsession)
home/casparcg/.cache
home/casparcg/.cache/*
home/casparcg/.cursor-server
home/casparcg/.cursor-server/*
home/casparcg/.cursor
home/casparcg/.cursor/*
home/casparcg/.antigravity-ide-server
home/casparcg/.antigravity-ide-server/*
home/casparcg/.gemini
home/casparcg/.gemini/*
home/casparcg/.vscode-server
home/casparcg/.vscode-server/*
home/casparcg/.local
home/casparcg/.local/*
home/casparcg/.ssh
home/casparcg/.ssh/*
home/casparcg/.npm
home/casparcg/.npm/*
home/casparcg/.nvm
home/casparcg/.nvm/*
home/casparcg/.config/Code
home/casparcg/.config/Code/*
home/casparcg/.config/Cursor
home/casparcg/.config/Cursor/*
home/casparcg/.config/cursor
home/casparcg/.config/cursor/*

# Tailscale node identity (deb + snap — all common layouts)
var/lib/tailscale
var/lib/tailscale/*
var/snap/tailscale
var/snap/tailscale/*
snap/tailscale
snap/tailscale/*
root/snap/tailscale
root/snap/tailscale/*
