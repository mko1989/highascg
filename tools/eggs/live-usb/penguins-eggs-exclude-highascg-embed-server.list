# HighAsCG — omit dev trees from squashfs; keep server runtime on ISO (standalone boot).
# Use with HIGHASCG_ISO_EMBED_SERVER=1 in prepare-eggs-clone-with-exfat.sh
# See docs/WO47_ISO_VS_EXFAT.md (exFAT drop-update/ still applies when stick present)

swap.img
swapfile

# ISO build tooling — not needed on playout live system
usr/lib/penguins-eggs
usr/lib/penguins-eggs/*

# Kernel/NVIDIA headers — build host only
usr/src
usr/src/*

opt/nvidia-pool
opt/nvidia-pool/*

# Browser UI sources (Vite build inputs — not served on playout; dist-web/ is baked on ISO)
home/casparcg/highascg/client
home/casparcg/highascg/client/*
home/casparcg/highascg/deprecated
home/casparcg/highascg/deprecated/*

# Deprecated + development scripts (WO-273 finding 5: archive_common_server_tar_members excludes on exFAT update)
home/casparcg/highascg/scripts/deprecated
home/casparcg/highascg/scripts/deprecated/*

home/casparcg/highascg/work
home/casparcg/highascg/work/*
home/casparcg/highascg/examples
home/casparcg/highascg/examples/*
home/casparcg/highascg/samples
home/casparcg/highascg/samples/*
home/casparcg/highascg/scratch
home/casparcg/highascg/scratch/*
home/casparcg/highascg/audio_testing
home/casparcg/highascg/audio_testing/*
home/casparcg/highascg/for_client
home/casparcg/highascg/for_client/*
home/casparcg/highascg/From_client
home/casparcg/highascg/From_client/*
home/casparcg/highascg/.git
home/casparcg/highascg/.git/*
home/casparcg/highascg/.reference
home/casparcg/highascg/.reference/*
home/casparcg/highascg/docs
home/casparcg/highascg/docs/*
home/casparcg/highascg/lib/libcef_dll
home/casparcg/highascg/lib/libcef_dll/*

# tools/ except runtime/ + startup/ (exfat-sync, Caspar helpers, post-boot QA on stick)
# Excludes: build-host only dev buckets (eggs, smoke, release, ci, map, wiki, replication, dev)
home/casparcg/highascg/tools/eggs
home/casparcg/highascg/tools/eggs/*
home/casparcg/highascg/tools/smoke
home/casparcg/highascg/tools/smoke/*
home/casparcg/highascg/tools/release
home/casparcg/highascg/tools/release/*
home/casparcg/highascg/tools/ci
home/casparcg/highascg/tools/ci/*
home/casparcg/highascg/tools/map
home/casparcg/highascg/tools/map/*
home/casparcg/highascg/tools/wiki
home/casparcg/highascg/tools/wiki/*
home/casparcg/highascg/tools/replication
home/casparcg/highascg/tools/replication/*
home/casparcg/highascg/tools/dev
home/casparcg/highascg/tools/dev/*

# Runtime under ~/highascg (stubs stay on ISO)
home/casparcg/highascg/media/*
home/casparcg/highascg/_media
home/casparcg/highascg/log
home/casparcg/highascg/log/*
home/casparcg/highascg/cef-cache
home/casparcg/highascg/cef-cache/*
home/casparcg/highascg/.env
home/casparcg/highascg/data
home/casparcg/highascg/data/*
home/casparcg/highascg/refs
home/casparcg/highascg/dist
home/casparcg/highascg/.github
home/casparcg/highascg/.github/*
home/casparcg/highascg/CT-SS-master
home/casparcg/highascg/CT-SS-master/*

# Device identity/secrets — MUST NOT ship on any produced ISO/clone (WO-168 T168.1)
home/casparcg/highascg/.private
home/casparcg/highascg/.private/*

# Trash tombstones + config backups (WO-168 T168.4) — factory reset also purges these
home/casparcg/highascg/projects/_trash
home/casparcg/highascg/projects/_trash/*
home/casparcg/highascg/config/*.bak*
home/casparcg/highascg/config/casparcg copy.config

# Build-host drop-update leftovers at repo root — the real .applied-stamp /
# .applied-at live under exfat|bridge drop-update/, not here (WO-168 T168.4;
# see src/system/server-update.js readAppliedStamp()). BUILD_STAMP and
# .highascg-build-stamp are NOT excluded — runtime reads them from repo root.
home/casparcg/highascg/.applied-at
home/casparcg/highascg/.applied-stamp

# exFAT mountpoint (empty in ISO)
home/casparcg/exfat
home/casparcg/exfat/*

# Companion dev tree (production tarball is ~/companion only)
home/casparcg/companion-module-dev
home/casparcg/companion-module-dev/*

# CasparCG build tree — build host only (WO-274). MEASURED 3328M in the shipped
# squashfs of the 2026-07-19 5.9GB ISO: the single largest unexcluded item.
# The runtime ships as ~/highascg/bin + ~/highascg/lib; nothing under src/,
# tools/runtime/, tools/startup/ or scripts/ references caspar-build.
home/casparcg/caspar-build
home/casparcg/caspar-build/*

# Boost headers — CasparCG *compile-time* only (183M measured in shipped tree).
# Kernel headers for DKMS live in usr/src (already excluded above); usr/include
# is C/C++ dev headers and is not read by anything at playout runtime.
usr/include/boost
usr/include/boost/*

# Operator browser profiles — identity + cache, regenerated on first launch.
# tools/runtime/highascg-launch-operator-firefox.sh does `mkdir -p "$PROFILE"`,
# so an absent profile dir is the normal cold-start path (247M measured).
home/casparcg/.highascg/firefox-operator
home/casparcg/.highascg/firefox-operator/*
home/casparcg/.highascg/cloud-browser-profile
home/casparcg/.highascg/cloud-browser-profile/*

# Crash dumps (79M measured — includes Zoom/Calamares/DKMS .crash files).
var/crash
var/crash/*

# apt/pkg caches (407M of .deb measured in the shipped tree). The upstream eggs
# template DOES intend to drop these, but its line reads
#   "var/cache/* var/lib/aide/*"
# — two patterns on ONE line, which mksquashfs -ef treats as a single literal
# pattern that matches nothing. Re-stated here one-per-line so it actually fires.
var/cache/*
var/lib/aide/*

# Copilot identity (parity with the WO-47 fragment list)
home/casparcg/.copilot
home/casparcg/.copilot/*

# Build-host working files (not needed on playout)
home/casparcg/highascg-backup-box.tgz
home/casparcg/highascg-wiki-map
home/casparcg/highascg-wiki-map/*
home/casparcg/highascg-mirror-push.log

# Snap user state (Firefox etc. on build host — not playout)
home/casparcg/snap
home/casparcg/snap/*

# casparcg build-host dotfiles (not .xsession)
home/casparcg/.cache
home/casparcg/.cache/*
home/casparcg/Downloads
home/casparcg/Downloads/*
home/casparcg/.cursor-server
home/casparcg/.cursor-server/*
home/casparcg/.cursor
home/casparcg/.cursor/*
home/casparcg/.antigravity-ide-server
home/casparcg/.antigravity-ide-server/*
home/casparcg/.gemini
home/casparcg/.gemini/*
home/casparcg/.vscode-server
home/casparcg/.vscode-server/*
home/casparcg/.local
home/casparcg/.local/*
home/casparcg/.ssh
home/casparcg/.ssh/*
home/casparcg/.npm
home/casparcg/.npm/*
home/casparcg/.nvm
home/casparcg/.nvm/*
home/casparcg/.config/Code
home/casparcg/.config/Code/*
home/casparcg/.config/Cursor
home/casparcg/.config/Cursor/*
home/casparcg/.config/cursor
home/casparcg/.config/cursor/*

# Zoom — dev/test tool on the build host only; MUST NOT ship on the ISO (WO-142 G1)
opt/zoom
opt/zoom/*
usr/bin/zoom
usr/share/applications/Zoom.desktop
usr/share/doc/zoom
usr/share/doc/zoom/*
usr/share/mime/packages/zoom.xml
usr/share/pixmaps/Zoom.png
usr/share/pixmaps/application-x-zoom.png

# Tailscale node identity (deb + snap — all common layouts)
var/lib/tailscale
var/lib/tailscale/*
var/snap/tailscale
var/snap/tailscale/*
snap/tailscale
snap/tailscale/*
root/snap/tailscale
root/snap/tailscale/*

# Remote-access / meeting / sync IDENTITY & LOGIN data — never ship (todos19.07.26).
# NoMachine excluded FULLY (binaries + config + user state), same policy as Zoom (WO-142).
usr/NX
usr/NX/*
etc/NX
etc/NX/*
home/casparcg/.nx
home/casparcg/.nx/*
# Zoom user identity (opt/zoom binaries excluded separately)
home/casparcg/.zoom
home/casparcg/.zoom/*
home/casparcg/.config/zoomus.conf
# Syncthing device identity + sync state (binary may ship; logins must not)
home/casparcg/.config/syncthing
home/casparcg/.config/syncthing/*
home/casparcg/.local/state/syncthing
home/casparcg/.local/state/syncthing/*
# Browser + assistant identity stores
home/casparcg/.mozilla
home/casparcg/.mozilla/*
home/casparcg/.claude
home/casparcg/.claude/*
home/casparcg/.claude.json
home/casparcg/highascg/.operator-firefox-profile
home/casparcg/highascg/.operator-firefox-profile/*
