# DeckLink / Blackmagic Desktop Video — omit from squashfs (WO-92).
# Build host may keep desktopvideo installed; eggs exclude masks paths during mksquashfs.
# Operators install from exFAT/bridge decklink/*.deb at boot (highascg-decklink-install.service).
#
# Paths are liveroot-relative (no leading /). Wildcards match eggs exclude.list conventions.

usr/lib/blackmagic
usr/lib/blackmagic/*
usr/lib/libDeckLinkAPI.so
usr/lib/libDeckLinkPreviewAPI.so
lib/udev/rules.d/55-blackmagic.rules
etc/udev/rules.d/55-blackmagic.rules
etc/init.d/DesktopVideoHelper
etc/init/DesktopVideoHelper.conf
etc/xdg/autostart/DesktopVideoUpdaterAutoStart.desktop
usr/bin/BlackmagicDesktopVideoSetup
usr/bin/BlackmagicFirmwareUpdater
usr/bin/DesktopVideoUpdateTool
usr/bin/DesktopVideoUpdater
usr/lib/systemd/system/DesktopVideoHelper.service
usr/share/applications/BlackmagicDesktopVideoSetup.desktop
usr/share/applications/DesktopVideoUpdater.desktop
usr/share/doc/desktopvideo
usr/share/doc/desktopvideo/*
usr/share/doc/desktopvideo-gui
usr/share/doc/desktopvideo-gui/*
var/lib/dkms/blackmagic
var/lib/dkms/blackmagic/*
var/lib/dkms/blackmagic-io
var/lib/dkms/blackmagic-io/*
var/lib/dpkg/info/desktopvideo.*
var/lib/dpkg/info/desktopvideo-gui.*
lib/modules/*/updates/dkms/blackmagic.ko*
lib/modules/*/updates/dkms/blackmagic-io.ko*
lib/modules/*/updates/dkms/snd_blackmagic-io.ko*
usr/src/blackmagic-*
