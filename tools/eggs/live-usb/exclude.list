# Based on: https://git.devuan.org/devuan/refractasnapshot-base/src/branch/master/snapshot_exclude.list
#
# Location: /etc/penguins-eggs.d/exclude.list
#
# penguins-eggs master template + HighAsCG WO-47 fragment (single block).
#
######################################################################################################

# SYSTEM:  Exclude some system files - These are required, and you probably shouldn't change them.
#          They are temporary files only created on bootup - otherwise would waste space on a clone
cdrom/*
dev/*
media/*
mnt/*
proc/*
run/*
swapfile
sys/*
tmp/*
dev/shm/*

# fedora/el9/etc
boot/*rescue*

*.cache

######################################################################################################
# LIVE STUFFS: files depending on live
etc/udev/rules.d/70-persistent-cd.rules
etc/udev/rules.d/70-persistent-net.rules
lib/live/*
live
persistence.conf
var/lib/live/config/*

######################################################################################################
# HARDWARE DEPENDAND FILES: created/updated during restoration of clone by calamares
boot/grub/device.map
boot/grub/grub.cfg
boot/grub/menu.lst
etc/blkid.tab
etc/blkid.tab.old
etc/fstab
etc/fstab.d/*
etc/mtab

######################################################################################################
# CACHES: that tend to be very large and unneeded - only for Arch and Debian based Linuxes

# Arch family
home/*/.local/share/yay

# Debian family

######################################################################################################
# MISC: miscellanea
.snapshots/*
etc/apt/*~
etc/crypttab
etc/initramfs-tools/conf.d/cryptroot
etc/initramfs-tools/conf.d/resume
etc/popularity-contest.conf
etc/skel/.config/Code
etc/skel/.local/share/baloo/*
etc/skel/.ZAP/*
lost+found
swap/*
swapfile
timeshift

######################################################################################################
# usr: use this exclusions, attention this can lead to lost something

# this list is intentionally blank

######################################################################################################
# var: use this exclusions, attention this can lead to lost something
var/backups/*
var/cache/* var/lib/aide/*
var/lib/apt/*~
var/lib/apt/cache/*
var/lib/apt/cdroms.list
var/lib/apt/daily_lock
var/lib/apt/extended_states
var/lib/apt/listchanges.db
var/lib/apt/lists/
var/lib/apt/mirrors/
var/lib/apt/periodic/
var/lib/aptitude/*.old
var/lib/cache/*

# NON CANCELLARE QUESTO SU DEVUAN!
# var/lib/dbus/machine-id

var/lib/dhcp/*
var/lib/dkms/wireguard/*
var/lib/dpkg/*~old
var/lib/gems/2.7.0/cache/*
var/log/*.log
var/log/*.log.?
var/log/*/*
var/spool/postfix/*
var/tmp/*

# --- HighAsCG tools/eggs/live-usb: see EGGS_EXCLUDE_LIST.md ---
swap.img
swapfile

# Single-driver ISO — no multi-branch deb pool (WO single-nvidia-driver-per-iso)
opt/nvidia-pool
opt/nvidia-pool/*
# WO-47 server-tree excludes (index.js, src/, node_modules/, dist-web/, …) live in
# penguins-eggs-exclude-highascg-fragment.list — merged only when HIGHASCG_ISO_EMBED_SERVER=0.
# Embed-server ISOs merge penguins-eggs-exclude-highascg-embed-server.list instead.
home/casparcg/highascg/media/*
home/casparcg/highascg/_media
home/casparcg/highascg/log
home/casparcg/highascg/log/*
home/casparcg/highascg/cef-cache
home/casparcg/highascg/cef-cache/*
home/casparcg/highascg/data
home/casparcg/highascg/data/*
home/casparcg/highascg/refs
home/casparcg/highascg/dist
home/casparcg/highascg/.github
home/casparcg/highascg/.github/*
# Build-host sync copies (not needed on live system)
home/casparcg/bridge
home/casparcg/bridge/*
home/casparcg/exfat
home/casparcg/exfat/*
home/casparcg/0x200014
home/casparcg/0x200014/*
home/casparcg/.cache
home/casparcg/.cache/*
home/casparcg/Downloads
home/casparcg/Downloads/*
home/casparcg/.copilot
home/casparcg/.copilot/*
home/casparcg/.cursor-server
home/casparcg/.cursor-server/*
home/casparcg/.cursor
home/casparcg/.cursor/*
home/casparcg/.antigravity-ide-server
home/casparcg/.antigravity-ide-server/*
home/casparcg/.gemini
home/casparcg/.gemini/*
home/casparcg/.vscode-server
home/casparcg/.vscode-server/*
home/casparcg/.local
home/casparcg/.local/*
home/casparcg/.ssh
home/casparcg/.ssh/*
home/casparcg/.npm
home/casparcg/.npm/*
home/casparcg/.nvm
home/casparcg/.nvm/*
home/casparcg/.config/Code
home/casparcg/.config/Code/*
home/casparcg/.config/Cursor
home/casparcg/.config/Cursor/*
home/casparcg/.config/cursor
home/casparcg/.config/cursor/*
var/lib/tailscale
var/lib/tailscale/*
var/snap/tailscale
var/snap/tailscale/*
snap/tailscale
snap/tailscale/*
root/snap/tailscale
root/snap/tailscale/*

# --- DeckLink / Blackmagic Desktop Video (WO-92 — operator-supplied, not in redistributable ISO) ---
usr/lib/blackmagic
usr/lib/blackmagic/*
usr/lib/libDeckLinkAPI.so
usr/lib/libDeckLinkPreviewAPI.so
lib/udev/rules.d/55-blackmagic.rules
etc/udev/rules.d/55-blackmagic.rules
etc/init.d/DesktopVideoHelper
etc/init/DesktopVideoHelper.conf
etc/xdg/autostart/DesktopVideoUpdaterAutoStart.desktop
usr/bin/BlackmagicDesktopVideoSetup
usr/bin/BlackmagicFirmwareUpdater
usr/bin/DesktopVideoUpdateTool
usr/bin/DesktopVideoUpdater
usr/lib/systemd/system/DesktopVideoHelper.service
usr/share/applications/BlackmagicDesktopVideoSetup.desktop
usr/share/applications/DesktopVideoUpdater.desktop
usr/share/doc/desktopvideo
usr/share/doc/desktopvideo/*
usr/share/doc/desktopvideo-gui
usr/share/doc/desktopvideo-gui/*
var/lib/dkms/blackmagic
var/lib/dkms/blackmagic/*
var/lib/dkms/blackmagic-io
var/lib/dkms/blackmagic-io/*
var/lib/dpkg/info/desktopvideo.*
var/lib/dpkg/info/desktopvideo-gui.*
lib/modules/*/updates/dkms/blackmagic.ko*
lib/modules/*/updates/dkms/blackmagic-io.ko*
lib/modules/*/updates/dkms/snd_blackmagic-io.ko*
usr/src/blackmagic-*
