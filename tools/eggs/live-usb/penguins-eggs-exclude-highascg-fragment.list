# Build-only compilers. NEVER the kernel's gcc (CONFIG_CC_VERSION_TEXT; 15 on 7.0.0-38): DKMS needs it, and the
# verifier fails the ISO without it. Clang/LLVM runtime .so files live in usr/lib/x86_64-linux-gnu and stay.
usr/libexec/gcc/x86_64-linux-gnu/13
usr/libexec/gcc/x86_64-linux-gnu/13/*
usr/libexec/gcc/x86_64-linux-gnu/16
usr/libexec/gcc/x86_64-linux-gnu/16/*
usr/lib/gcc/x86_64-linux-gnu/13
