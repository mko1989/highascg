usr/lib/gcc/x86_64-linux-gnu/16
usr/lib/gcc/x86_64-linux-gnu/16/*
usr/lib/llvm-18
usr/lib/llvm-18/*
usr/lib/llvm-21
usr/lib/llvm-21/*
usr/lib/go-*
usr/share/go-*
home/casparcg/go
home/casparcg/go/*
