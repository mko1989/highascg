# SSH host keys: eggs copies them as-is, so every clone would share one host identity. The ssh.service drop-in
# (systemd/ssh.service.d-05-host-keys.conf.example, installed by prepare-eggs-clone-with-exfat.sh) runs
# `ssh-keygen -A`, which creates only the missing keys, before sshd starts.
etc/ssh/ssh_host_*
