# HighAsCG — omit from squashfs (liveroot-relative paths, no leading /)
# ISO = Caspar shell; Node server from exFAT drop-update/ (tools/runtime/ in tarball)
# See docs/WO47_ISO_VS_EXFAT.md

swap.img
swapfile

# ISO build tooling — not needed on playout live system
usr/lib/penguins-eggs
usr/lib/penguins-eggs/*

# Kernel/NVIDIA headers — build host only
# WO-433: usr/src ships (linux-headers for DeckLink DKMS at GUI-install time);
# only driver source trees are masked — see the embed-server fragment note.
usr/src/nvidia-*
usr/src/blackmagic-*

# Multi-branch NVIDIA deb cache (removed — one driver baked per ISO)
opt/nvidia-pool
opt/nvidia-pool/*

