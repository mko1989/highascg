// HighAsCG Plymouth — logs left 2/3, scaled logo right 1/3 (opaque RGB).
animation_frames = @@FRAME_COUNT@@;
animation_index = 0;
animation_image = [];
animation_sprite = [];

NUM_SCROLL_LINES = 20;
LINE_HEIGHT = 18;
LINE_WIDTH = 72;
scroll_line_text = [];
scroll_sprites = [];

for (i = 0; i < animation_frames; i++) {
	animation_image[i] = Image(sprintf("animation-%04d.png", i + 1));
}

for (i = 0; i < NUM_SCROLL_LINES; i++) {
	scroll_line_text[i] = "";
	scroll_sprites[i] = Sprite();
	scroll_sprites[i].SetOpacity(0);
}

fun log_panel_width () {
	return Window.GetWidth() * 2 / 3;
}

fun logo_panel_left () {
	return log_panel_width();
}

fun frame_for_panel (idx) {
	global animation_image;
	img = animation_image[idx];
	panel_w = Window.GetWidth() - logo_panel_left();
	panel_h = Window.GetHeight();
	max_w = panel_w * 0.88;
	max_h = panel_h * 0.88;
	iw = img.GetWidth();
	ih = img.GetHeight();
	if (iw <= max_w && ih <= max_h) {
		return img;
	}
	scale_w = max_w / iw;
	scale_h = max_h / ih;
	scale = scale_w;
	if (scale_h < scale_w) {
		scale = scale_h;
	}
	return img.Scale(iw * scale, ih * scale);
}

fun place_animation () {
	global animation_sprite;
	sw = animation_sprite.GetWidth();
	sh = animation_sprite.GetHeight();
	panel_w = Window.GetWidth() - logo_panel_left();
	animation_sprite.SetX(logo_panel_left() + (panel_w - sw) / 2);
	animation_sprite.SetY((Window.GetHeight() - sh) / 2);
}

fun place_scroll_lines () {
	global scroll_sprites;
	global NUM_SCROLL_LINES;
	global LINE_HEIGHT;
	start_x = 16;
	start_y = 24;
	for (i = 0; i < NUM_SCROLL_LINES; i++) {
		scroll_sprites[i].SetX(start_x);
		scroll_sprites[i].SetY(start_y + (i * LINE_HEIGHT));
	}
}

fun refresh_scroll_display () {
	global scroll_line_text;
	global scroll_sprites;
	global NUM_SCROLL_LINES;

	for (i = 0; i < NUM_SCROLL_LINES; i++) {
		if (string_length(scroll_line_text[i]) > 0) {
			scroll_sprites[i].SetImage(Image.Text(scroll_line_text[i], 0.75, 0.88, 0.95));
			scroll_sprites[i].SetOpacity(1);
		} else {
			scroll_sprites[i].SetOpacity(0);
		}
	}
}

fun refresh_callback () {
	global animation_index;
	global animation_sprite;
	global animation_frames;

	animation_sprite.SetImage(frame_for_panel(animation_index));
	animation_index = (animation_index + 1) % animation_frames;
	place_animation();
}

fun string_length (s) {
	idx = 0;
	while (s.CharAt(idx)) {
		idx++;
	}
	return idx;
}

fun append_status_line (text) {
	global scroll_line_text;
	global NUM_SCROLL_LINES;
	global LINE_WIDTH;

	if (string_length(text) == 0) {
		return;
	}

	if (string_length(text) > LINE_WIDTH) {
		text = text.SubString(0, LINE_WIDTH - 3);
		text = text + "...";
	}

	for (i = 0; i < NUM_SCROLL_LINES - 1; i++) {
		scroll_line_text[i] = scroll_line_text[i + 1];
	}
	scroll_line_text[NUM_SCROLL_LINES - 1] = text;
	refresh_scroll_display();
}

fun display_message_callback (text) {
	append_status_line(text);
}

fun update_status_callback (text) {
	append_status_line(text);
}

fun resize_callback () {
	place_animation();
	place_scroll_lines();
}

fun boot_up () {
	global animation_sprite;

	Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
	Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

	animation_sprite = Sprite(frame_for_panel(0));
	animation_sprite.SetOpacity(1);
	place_animation();
	place_scroll_lines();

	Plymouth.SetRefreshFunction(refresh_callback);
	Plymouth.SetResizeFunction(resize_callback);
	Plymouth.SetDisplayMessageFunction(display_message_callback);
	Plymouth.SetUpdateStatusFunction(update_status_callback);
}

Plymouth.SetBootUpFunction(boot_up);
