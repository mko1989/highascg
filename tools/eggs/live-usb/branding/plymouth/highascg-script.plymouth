ModuleName=script
ImageDir=/usr/share/plymouth/themes/highascg
ScriptFile=/usr/share/plymouth/themes/highascg/highascg.script

[script]
ImageDir=/usr/share/plymouth/themes/highascg
ScriptFile=/usr/share/plymouth/themes/highascg/highascg.script
