[Plymouth Theme]
Name=HighAsCG
Description=HighAsCG boot splash (small throbber only, boot messages below)
ModuleName=two-step

[two-step]
Font=Cantarell 12
TitleFont=Cantarell Light 30
ImageDir=/usr/share/plymouth/themes/highascg
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.382
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.36
HorizontalAlignment=.5
VerticalAlignment=.55
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.08
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x0c1220
BackgroundEndColor=0x0c1528
ProgressBarBackgroundColor=0x3a4a5c
ProgressBarForegroundColor=0x5eb3ff
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=HighAsCG — installing updates…
SubTitle=Do not turn off the computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=HighAsCG — upgrading…
SubTitle=Do not turn off the computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=HighAsCG — firmware upgrade…
SubTitle=Do not turn off the computer

[system-reset]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=HighAsCG — resetting…
SubTitle=Do not turn off the computer
