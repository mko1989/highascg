# WO-319 — HTTPS reverse proxy for the highascg UI, so LAN clients get a secure context
# (required for WebCodecs / the live GUI preview). Terminates TLS on :4443 and forwards to the
# plain-HTTP app server on :4200. Self-signed cert auto-generated on first start.
#
# Install (owner, once):
#   sudo cp tools/runtime/highascg-https-proxy.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now highascg-https-proxy
#   sudo systemctl status highascg-https-proxy
#
# Then LAN clients open https://<box-ip>:4443/ , accept the self-signed warning once, and the
# "Live preview" toggle appears. The operator kiosk keeps using http://127.0.0.1:4200 unchanged.

[Unit]
Description=highascg HTTPS reverse proxy (TLS for LAN WebCodecs preview)
After=network.target highascg.service
Wants=highascg.service

[Service]
Type=simple
User=casparcg
WorkingDirectory=/home/casparcg/highascg
ExecStart=/usr/bin/node /home/casparcg/highascg/tools/runtime/highascg-https-proxy.js
Environment=HTTPS_PORT=4443
Environment=TARGET_PORT=4200
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
