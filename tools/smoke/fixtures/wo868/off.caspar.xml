<configuration>
    <paths>
        <media-path>media/</media-path>
        <log-path disable="false">log/</log-path>
        <data-path>data/</data-path>
        <template-path>template/</template-path>
    </paths>
    <lock-clear-phrase>secret</lock-clear-phrase>
    <log-level>info</log-level>
    <system-audio>
        <device-name/>
    </system-audio>
    <portaudio>
        <device-name>hw:1,3</device-name>
        <device>hw:1,3</device>
        <host-api>auto</host-api>
        <output-channels>8</output-channels>
        <channels>8</channels>
        <buffer-size-frames>128</buffer-size-frames>
        <latency-compensation-ms>40</latency-compensation-ms>
        <auto-tune-latency>true</auto-tune-latency>
        <fifo-ms>50</fifo-ms>
    </portaudio>
    <audio>
        <channel-layouts>
            <channel-layout>
                <name>discrete-8ch</name>
                <type>8ch</type>
                <num-channels>8</num-channels>
                <channel-order>c0 c1 c2 c3 c4 c5 c6 c7</channel-order>
            </channel-layout>
        </channel-layouts>
    </audio>
    <!-- HighAsCG: Each channel block starts with a comment naming its Caspar index and role (PGM program, PRV preview, DeckLink inputs host, multiview, streaming, monitor). -->
    <channels>
        <!-- HighAsCG: Caspar channel 1: Screen 1 program output (PGM) -->
        <channel>
            <video-mode>3840x1792</video-mode>
            <channel-layout>discrete-8ch</channel-layout>
            <consumers>
                <screen>
                    <device>1</device>
                    <stretch>none</stretch>
                    <windowed>true</windowed>
                    <key-only>false</key-only>
                    <vsync>false</vsync>
                    <borderless>true</borderless>
                    <interactive>true</interactive>
                    <always-on-top>true</always-on-top>
                    <x>0</x><y>0</y>
                    <width>3840</width><height>1792</height>
                    <sbs-key>false</sbs-key>
                    <colour-space>RGB</colour-space>
                    <force-linear-filter>false</force-linear-filter>
                    <high-bitdepth>false</high-bitdepth>
                    <gpu-texture>true</gpu-texture>
                </screen>
                <portaudio/>
            </consumers>
            <mixer>
                <audio-osc>true</audio-osc>
            </mixer>
        </channel>
        <!-- HighAsCG: Caspar channel 2: Screen 1 preview output (PRV) -->
        <channel>
            <video-mode>3840x1792</video-mode>
            <consumers></consumers>
            <mixer>
                <audio-osc>true</audio-osc>
            </mixer>
        </channel>
        <!-- HighAsCG: Caspar channel 3: Screen 2 program output (PGM) -->
        <channel>
            <video-mode>1080p5000</video-mode>
            <channel-layout>stereo</channel-layout>
            <consumers>
                <decklink>
                    <device>4</device>
                    <video-mode>1080p5000</video-mode>
                    <keyer>default</keyer>
                    <embedded-audio>true</embedded-audio>
                    <channel-layout>stereo</channel-layout>
                    <latency>normal</latency>
                    <buffer-depth>3</buffer-depth>
                    <color-space>bt709</color-space>
                </decklink>
            </consumers>
            <mixer>
                <audio-osc>true</audio-osc>
            </mixer>
        </channel>
        <!-- HighAsCG: Caspar channel 4: Screen 2 preview output (PRV) -->
        <channel>
            <video-mode>1080p5000</video-mode>
            <consumers></consumers>
            <mixer>
                <audio-osc>true</audio-osc>
            </mixer>
        </channel>
        <!-- HighAsCG: Caspar channel 5: Operator GUI channel "Operator GUI" — SHARED MEMORY /dev/shm/highascg-opgui for the native client (WO-593/594); routed preview layers (10-49) unchanged -->
        <channel>
            <video-mode>1080p5000</video-mode>
            <consumers>
                <shm>
                    <name>opgui</name>
                </shm>
            </consumers>
            <mixer>
                <audio-osc>true</audio-osc>
            </mixer>
        </channel>
        <!-- HighAsCG: Caspar channel 6: DeckLink input 1 (PLAY 6-1 DECKLINK <device>; dedicated channel, isolated VU) -->
        <channel>
            <video-mode>1080p5000</video-mode>
            <channel-layout>stereo</channel-layout>
            <consumers>
            </consumers>
            <mixer>
                <audio-osc>true</audio-osc>
            </mixer>
        </channel>
        <!-- HighAsCG: Caspar channel 7: Live audio input 1 (ALSA PLAY … alsa:// on layer 10; cheap channel, isolated VU) -->
        <channel>
            <video-mode>1080p5000</video-mode>
            <channel-layout>stereo</channel-layout>
            <consumers>
            </consumers>
            <mixer>
                <audio-osc>true</audio-osc>
            </mixer>
        </channel>
        <!-- HighAsCG: Caspar channel 8: Monitor / headphone mix (system-audio consumer) -->
        <channel>
            <video-mode>720p5000</video-mode>
            <consumers>
                <system-audio>
                    <device-name>sc60mon</device-name>
                </system-audio>
            </consumers>
            <mixer>
                <audio-osc>true</audio-osc>
            </mixer>
        </channel>
    </channels>
    <video-modes>
        <video-mode>
            <id>3840x1792</id>
            <width>3840</width>
            <height>1792</height>
            <time-scale>50000</time-scale>
            <duration>1000</duration>
            <cadence>960</cadence>
        </video-mode>
    </video-modes>
    <controllers><tcp><port>5250</port><protocol>AMCP</protocol></tcp>
    </controllers>
    <osc>
        <default-port>6250</default-port>
        <disable-send-to-amcp-clients>false</disable-send-to-amcp-clients>
        <predefined-clients>
            <predefined-client>
                <address>127.0.0.1</address>
                <port>6251</port>
            </predefined-client>
        </predefined-clients>
    </osc>

    <amcp><media-server><host>localhost</host><port>8000</port></media-server></amcp>
    <ndi><auto-load>true</auto-load></ndi>
    <decklink/>
    <!-- HighAsCG WO-790: decoder threads per file. Caspar's default (0 = one per core) fills that many frame threads before the first picture of a seek (~50 ms on 4K NotchLC); 4 still decodes 4K NotchLC / ProRes / H.264 50p several times faster than real time. -->
    <ffmpeg><producer><threads>4</threads></producer></ffmpeg>
    <html>
        <enable-gpu>false</enable-gpu>
        <remote-debugging-port>9222</remote-debugging-port>
    </html>
</configuration>