# Server (playout host). Copy to .env on the machine that runs `npm start`.
#
# Production default: serve API + dist-web/ on :4200 (headless OFF).
# Uncomment only for API-only debug:
# HIGHASCG_HEADLESS=true

# Optional: allow UI from extra origins (comma-separated), e.g. operator laptop Vite dev
# HIGHASCG_CORS_ORIGINS=http://192.168.0.10:4350,http://127.0.0.1:4350
